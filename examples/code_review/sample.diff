diff --git a/app/users.py b/app/users.py
index 5742aba..20ddc3d 100644
--- a/app/users.py
+++ b/app/users.py
@@ -2,9 +2,28 @@
 
 from __future__ import annotations
 
+import logging
 import sqlite3
 
+log = logging.getLogger(__name__)
+
 
 def find_user(conn: sqlite3.Connection, user_id: int) -> tuple | None:
     """Fetch one user row by id."""
     return conn.execute("SELECT id, name, email FROM users WHERE id = ?", (user_id,)).fetchone()
+
+
+def search_users(conn: sqlite3.Connection, name: str, limit: int = 20) -> list[tuple]:
+    """Find users whose name starts with `name`."""
+    query = "SELECT id, name, email FROM users WHERE name LIKE '" + name + "%' LIMIT " + str(limit)
+    try:
+        return conn.execute(query).fetchall()
+    except:
+        log.warning("user search failed for %s", name)
+        return []
+
+
+def deactivate_user(conn: sqlite3.Connection, user_id: int) -> None:
+    """Mark a user inactive."""
+    conn.execute(f"UPDATE users SET active = 0 WHERE id = {user_id}")
+    conn.commit()
