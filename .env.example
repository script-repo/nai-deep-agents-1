# Copy to .env and edit. Never commit .env. Every variable can also be set in the environment.

# ---------- Model ----------
# mock | openai_compatible | openai | anthropic | ollama
LLM_PROVIDER=mock
LLM_MODEL=mock-large
# Required for openai_compatible. Examples:
#   Nutanix Enterprise AI: https://<nai-host>/api/v1          (model = your NAI endpoint name)
#   vLLM:                  http://vllm.internal:8000/v1
#   LM Studio:             http://localhost:1234/v1
#   Ollama (OpenAI API):   http://localhost:11434/v1
#   LiteLLM proxy:         http://litellm:4000/v1
# LLM_BASE_URL=
# LLM_API_KEY=
LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=120
# Candidate models for routing / reviews / evals (defaults to examples/models.yaml)
# MODEL_CATALOG=/etc/nai-agents/models.yaml

# ---------- App ----------
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./var
# memory | sqlite | postgres
APP_CHECKPOINTER=sqlite
# APP_DATABASE_URL=postgresql://nai:change-me@localhost:5432/nai_agents
# Shared deployments: set a token and/or basic-auth users (user:password or user:sha256:<hex>)
# APP_AUTH_TOKEN=
# APP_BASIC_AUTH=alice:change-me,bob:sha256:0f3c...
APP_ALLOW_UI_MODEL_SETTINGS=true
APP_ALLOW_UI_API_KEYS=false
# APP_CORS_ORIGINS=http://localhost:5173
APP_LOG_LEVEL=info
# Let the fleet manager run installed coding CLIs (claude, codex, cursor-agent)
APP_ENABLE_EXTERNAL_CLI=false
